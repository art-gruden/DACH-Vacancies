# --- Telegram -----------------------------------------------------------------
BOT_TOKEN=123456:ABC...                # from @BotFather
ADMIN_IDS=[]                           # JSON list of Telegram ids, e.g. [123456789]
DEFAULT_LANGUAGE=ru

# --- database (docker-compose sets DATABASE_URL itself) -------------------------
BOT_DB_PASSWORD=change-me
# DATABASE_URL=postgresql+asyncpg://bot:change-me@localhost:5432/vacancies_bot

# --- crawler Bot API (read-only) ------------------------------------------------
# On the crawler host:  docker compose exec api python -m gcc_core.botauth generate telegram
#   → put the printed "telegram:sha256:<hex>" line into the CRAWLER's .env as BOT_API_KEYS, restart the crawler API,
#   → put the printed TOKEN here. Never commit it.
CRAWLER_BASE_URL=https://crawdler.duckdns.org/api/bot/v1
CRAWLER_API_TOKEN=
CRAWLER_TIMEOUT_S=20
FACETS_TTL_S=900

# --- feed / notifications --------------------------------------------------------
FEED_POLL_INTERVAL_S=60
FEED_PAGE_SIZE=200
PROCESSOR_INTERVAL_S=15
SENDER_INTERVAL_S=5
INBOX_RETENTION_DAYS=14
DIGEST_THRESHOLD=3
MORNING_DIGEST_HOUR=8
EVENING_DIGEST_HOUR=19

# --- AI (optional; everything works with AI_PROVIDER=none) ------------------------
AI_PROVIDER=none                       # none | openai_compat
AI_PROVIDER_LABEL=локальная модель Ollama на сервере бота   # shown to users in consent texts
AI_BASE_URL=http://ollama:11434/v1
AI_API_KEY=
AI_CHAT_MODEL=qwen2.5:7b-instruct
AI_EMBED_MODEL=                        # e.g. nomic-embed-text; empty = no semantic reranking
AI_MONTHLY_BUDGET_USD=5
AI_DAILY_USER_CALLS=30
AI_PRICE_IN_PER_1K=0
AI_PRICE_OUT_PER_1K=0
AI_SEMANTIC_WEIGHT=0.2

# --- CV --------------------------------------------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CV_ENCRYPTION_KEY=
CV_RETENTION_HOURS=24
CV_MAX_BYTES=5242880

LOG_LEVEL=INFO
